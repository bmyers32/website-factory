---
// Optional-feature interface, per CLAUDE.md — build/use only when a client spec
// sets contact_form: on. Field set is data-driven via `fields` (see
// src/lib/contact-fields.ts) so this stays a reusable primitive rather than
// hardcoding one client's field list.
//
// This build (Copperline fixture, Checkpoint 2+ correction round 3): action,
// recipient, confirmation copy, and retention rule are all specified (see
// CLIENT_SPEC §7/§8 and functions/api/contact.ts) — the only thing still
// outstanding is *secrets*. functions/api/contact.ts fails closed (returns a
// phone-fallback response, never a crash or a false success) whenever
// RESEND_API_KEY / CONTACT_RECIPIENT are unset, so wiring `action` live here
// does not make the form operational in the sense that matters — it only
// becomes operational once the operator adds those secrets in the Cloudflare
// dashboard at QA. Do not represent it as operational before that.
import FormField from './FormField.astro';
import { honeypotFieldName, type ContactFieldDef } from '../lib/contact-fields';

interface Props {
  action: string;
  fields: ContactFieldDef[];
  submitLabel?: string;
}

const { action, fields, submitLabel = 'Send message' } = Astro.props;
---

<form class="contact-form" method="POST" action={action} novalidate={false}>
  {fields.map((field) => <FormField {...field} />)}

  <!-- Honeypot: real visitors never see or fill this. Server must reject any
       submission where this field is non-empty. -->
  <div class="hp-field" aria-hidden="true">
    <label for={`field-${honeypotFieldName}`}>Company</label>
    <input id={`field-${honeypotFieldName}`} name={honeypotFieldName} type="text" tabindex="-1" autocomplete="off" />
  </div>

  <button type="submit">{submitLabel}</button>
</form>

<style>
  .contact-form {
    max-width: 32rem;
  }

  .hp-field {
    position: absolute;
    left: -9999px;
    top: -9999px;
  }

  .contact-form button[type='submit'] {
    background: var(--c-accent);
    color: var(--c-surface);
    border: 2px solid var(--c-accent);
    border-radius: var(--radius-base);
    padding: var(--sp-2) var(--sp-4);
    font-weight: 700;
    font: inherit;
    font-family: var(--font-display);
    cursor: pointer;
  }

  .contact-form button[type='submit']:hover {
    background: var(--c-ink);
    border-color: var(--c-ink);
  }
</style>
