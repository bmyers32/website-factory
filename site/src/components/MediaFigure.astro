---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  widths?: number[];
  sizes?: string;
  loading?: 'eager' | 'lazy';
}

const { src, alt, caption, widths = [400, 800, 1200], sizes = '100vw', loading = 'lazy' } = Astro.props;

if (!alt.trim()) {
  throw new Error('MediaFigure requires a non-empty alt (use alt="" only via a dedicated decorative variant).');
}
---

<figure class="media-figure">
  <Image src={src} alt={alt} widths={widths} sizes={sizes} loading={loading} />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .media-figure {
    margin: 0;
    /* Grid/flex items default to min-width:auto, which resolves to a
       replaced element's intrinsic size and can silently override
       `img { max-width: 100% }` at the track-sizing stage — the image
       renders "shrunk" but the grid track (and the whole row) still grows
       to its intrinsic width, overflowing the viewport. min-width: 0 here
       lets the track shrink to the container instead. (Caught during
       Phase 5 QA: a 390px viewport was overflowing horizontally because
       of exactly this on the hero and about-section images.) */
    min-width: 0;
  }

  .media-figure img {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-base);
  }

  .media-figure figcaption {
    margin-top: var(--sp-2);
    font-size: var(--fs-1);
    color: var(--c-ink-muted);
  }
</style>
