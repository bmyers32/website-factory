---
interface Props {
  name: string;
  label: string;
  type?: 'text' | 'email' | 'tel' | 'textarea';
  required?: boolean;
  autocomplete?: string;
}

const { name, label, type = 'text', required = false, autocomplete } = Astro.props;
const id = `field-${name}`;
const errorId = `${id}-error`;
---

<div class="form-field">
  <label for={id}>
    {label}
    {required && <span aria-hidden="true"> *</span>}
  </label>
  {
    type === 'textarea' ? (
      <textarea id={id} name={name} required={required} aria-describedby={errorId} rows={5} />
    ) : (
      <input id={id} name={name} type={type} required={required} autocomplete={autocomplete} aria-describedby={errorId} />
    )
  }
  <p id={errorId} class="form-field-error" role="alert" hidden />
</div>

<style>
  .form-field {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
    margin-bottom: var(--sp-3);
  }

  .form-field label {
    font-weight: 600;
  }

  .form-field input,
  .form-field textarea {
    font: inherit;
    padding: var(--sp-2);
    border: 1px solid var(--c-ink-muted);
    border-radius: var(--radius-base);
    background: var(--c-surface);
    color: var(--c-ink);
  }

  /* Non-color error state: icon-free text callout, not just a red border. */
  .form-field-error {
    color: var(--c-accent);
    font-size: var(--fs-1);
    margin: 0;
  }

  .form-field-error:not([hidden])::before {
    content: 'Error: ';
    font-weight: 700;
  }
</style>
